{
  "name": "@weth/asp-api",
  "version": "2.0.0",
  "type": "module",
  "description": "WETH Guardian ASP Runtime API Service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter @weth/shared build && pnpm --filter @weth/database build && pnpm --filter @weth/blockchain build && pnpm --filter @weth/agent build && tsc",
    "dev": "PORT=3003 tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@weth/agent": "workspace:*",
    "@weth/blockchain": "workspace:*",
    "@weth/database": "workspace:*",
    "@weth/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "fastify-plugin": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
}
